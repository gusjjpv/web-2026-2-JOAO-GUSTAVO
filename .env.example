# Copie este arquivo para ".env.local" (ignorado pelo git) e preencha com os
# valores do seu User Pool no console da AWS (Cognito > User pools).
#
# Esses valores NÃO são segredos — ficam visíveis no bundle do navegador.
# O App Client deve ser "Public client", SEM client secret.

# Ex: us-east-1_AbCdEfGhI  (a região é deduzida do prefixo do ID)
VITE_COGNITO_USER_POOL_ID=
# Ex: 1h57kf5cpq17m0eml12EXAMPLE
VITE_COGNITO_CLIENT_ID=

# Domínio do Cognito para OAuth (Google, etc.) — sem https://
# Ex: us-east-1sqlples7n.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
